<?php
$ext_id = Minz_Request::param('e', 'ShaarliSync');
$ext = null;
if (isset($this->extension) && $this->extension !== null) {
    $ext = $this->extension;
} elseif (class_exists('Minz_ExtensionManager')) {
    $ext = Minz_ExtensionManager::findExtension($ext_id);
}

$getVal = function($key, $default = '') use ($ext) {
    if ($ext !== null && method_exists($ext, 'getUserConfigurationValue')) {
        $v = $ext->getUserConfigurationValue($key);
        if ($v !== null && $v !== '') return $v;
    }
    return $default;
};

$t = function($key, $fallback = '') {
    $s = _t('ext.shaarlisync.' . $key);
    return ($s !== 'ext.shaarlisync.' . $key && !empty($s)) ? $s : $fallback;
};

$csrf = '';
if (class_exists('FreshRSS_Auth') && method_exists('FreshRSS_Auth', 'csrfToken')) {
    $csrf = FreshRSS_Auth::csrfToken();
}

$testReport = null;
if (class_exists('Minz_Session')) {
    $testReport = Minz_Session::param('shaarlisync_test_report');
    Minz_Session::_param('shaarlisync_test_report', null);
}
?>

<?php if (!empty($testReport)): ?>
  <div class="alert <?php echo $testReport['ok'] ? 'alert-success' : 'alert-error'; ?>" style="margin-bottom: 20px; padding: 12px; border-radius: 4px;">
    <strong><?php echo htmlspecialchars($t('diag_title', 'Rapport de diagnostic :')); ?></strong>
    <ul style="margin: 8px 0 0 20px;">
      <?php foreach ($testReport['logs'] as $log): ?>
        <li><?php echo htmlspecialchars($log); ?></li>
      <?php endforeach; ?>
    </ul>
  </div>
<?php endif; ?>

